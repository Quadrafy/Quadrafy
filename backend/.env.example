PORT=4173
NODE_ENV=development
SESSION_TTL_HOURS=168

# Origens de frontend autorizadas a executar mutações via proxy. Separe por vírgula.
ALLOWED_ORIGINS=https://quadrafy.vercel.app

# Use um volume persistente e privado. O diretório também guarda auditoria,
# tombstones de recorrências e o histórico retido do chat.
# DATA_DIR=C:/caminho/para/dados

# Os rate limits, o horizonte de 90 dias, o máximo de 8 reservas futuras e a
# retenção de 1.000 mensagens por partida são políticas fixas nesta versão.

# Opcional. Sem a chave, ou se a Anthropic falhar, o teste de nível usa o
# cálculo local determinístico e informa engine.usedFallback=true na resposta.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_MS=8000

# Identidade e URL pública usadas nos e-mails transacionais e nos links de
# redefinição de senha.
APP_NAME=Padelfy
APP_BASE_URL=https://www.padelfy.com.br

# Envio de e-mails (recuperação de senha) via Resend. Sem RESEND_API_KEY o
# mailer fica desabilitado e apenas registra um aviso (não quebra o fluxo).
# O remetente precisa estar em um domínio verificado no Resend.
RESEND_API_KEY=
RESEND_FROM=Padelfy <no-reply@padelfy.com.br>
PASSWORD_RESET_TTL_HOURS=1
EMAIL_VERIFICATION_TTL_HOURS=24

# Login com Google (OAuth). Sem CLIENT_ID/SECRET o botão "Continuar com Google"
# fica oculto e os endpoints /auth/google/* respondem como indisponíveis.
# No Google Cloud, registre o redirect URI abaixo (Authorized redirect URIs).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.padelfy.com.br/api/v1/auth/google/callback

# Verificação de telefone por WhatsApp via Evolution API (self-hosted). Sem
# essas variáveis o fluxo /auth/phone/* fica pronto mas não envia. Instância
# precisa estar conectada (QR pareado).
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
PHONE_VERIFICATION_TTL_MINUTES=10
